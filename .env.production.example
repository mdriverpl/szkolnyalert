NODE_ENV=production
PORT=3001
STORAGE_DRIVER=json
DEMO_DATA=false

# Trwały prywatny katalog poza katalogiem publicznym serwera WWW.
DATA_DIR=/var/lib/szkolnyalert
JSON_FILE=app.json
JSON_BACKUP_INTERVAL_MINUTES=60
JSON_BACKUP_LIMIT=48

# Zmień na faktyczny publiczny adres tej instalacji z HTTPS.
PUBLIC_APP_URL=https://szkolnyalert.pl

# Wklej obecny klucz z lokalnego .env, jeśli przenosisz istniejące dane.
# Dla nowej instalacji wygeneruj: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SMS_ENCRYPTION_KEY=

# DATABASE_URL i PostgreSQL nie są wymagane w tym trybie.
# Token SMSAPI zapisuje administrator szkoły w Ustawieniach aplikacji.

# Opcjonalny klucz Hostava. Wybierz Hostava i zapisz ustawienia SMS szkoły.
HOSTAVA_SMS_KEY=

# Superadministrator: wybór i zarządzanie wszystkimi szkołami.
# Zmiana hasła wymaga restartu serwera i unieważnia sesje tego konta.
SUPERADMIN_EMAIL=biuro@mdriver.pl
SUPERADMIN_PASSWORD=

# Web Push: stała para kluczy VAPID, prywatnego nie publikuj.
# Wygeneruj: node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:biuro@mdriver.pl

# Poczta do odzyskiwania hasła (TLS/STARTTLS wymagane).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
