# Domyślnie JSON z danymi demonstracyjnymi. Serwer: .env.production.example.
# PostgreSQL: ustaw URL. Pierwsze konto utworzysz formularzem Dodaj szkołę.
# DATABASE_URL=postgresql://szkolnyalert:localpassword@localhost:5432/szkolnyalert
# POSTGRES_PASSWORD=ustaw-haslo-lokalnej-bazy
PORT=3001
# Lokalny tryb JSON. Produkcja: użyj .env.production.example i DEMO_DATA=false.
STORAGE_DRIVER=json
DEMO_DATA=true
DATA_DIR=./data
JSON_FILE=demo.json
JSON_BACKUP_INTERVAL_MINUTES=60
JSON_BACKUP_LIMIT=48
# Aby użyć PostgreSQL: STORAGE_DRIVER=postgres oraz DATABASE_URL.
# Publiczny adres aplikacji dla osobistych linków wysyłanych SMS-em.
# PUBLIC_APP_URL=https://szkolnyalert.pl
# Produkcja JSON / PostgreSQL: klucz 32-bajtowy base64 do szyfrowania danych dostępu.
# Wygeneruj: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# SMS_ENCRYPTION_KEY=...
# Ten klucz szyfruje także osobiste linki tworzone przy dodaniu i imporcie nauczycieli.
# W lokalnym demo klucz jest automatycznie zapisywany w data/sms-encryption.key.
# Każde konto należy do jednej szkoły. Logowanie do danych szkoły jest wymagane.

# Opcjonalny klucz Hostava. Wybierz Hostava i zapisz ustawienia SMS szkoły.
HOSTAVA_SMS_KEY=

# Superadministrator: wybór i zarządzanie wszystkimi szkołami.
# Zmiana hasła wymaga restartu serwera i unieważnia sesje tego konta.
SUPERADMIN_EMAIL=biuro@mdriver.pl
SUPERADMIN_PASSWORD=

# Web Push: stała para kluczy VAPID, prywatnego nie publikuj.
# Wygeneruj: node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:biuro@mdriver.pl

# Poczta do odzyskiwania hasła (TLS/STARTTLS wymagane).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
